function hrsMinsFormat(totalSecs) {
  const h = Math.floor(totalSecs / 3600);
  const m = Math.floor((totalSecs % 3600) / 60);
  if (h > 0) return `${h}h ${m}m`;
  return `${m} mins`;
}

function playCompletionChime() {
  if (isAudioEnabled) {
    try {
      const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      const osc1 = audioCtx.createOscillator();
      const gain1 = audioCtx.createGain();
      osc1.type = 'sine';
      osc1.frequency.value = 659.25;
      gain1.gain.setValueAtTime(0.4, audioCtx.currentTime);
      gain1.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.4);
      osc1.connect(gain1);
      gain1.connect(audioCtx.destination);
      osc1.start(audioCtx.currentTime);
      osc1.stop(audioCtx.currentTime + 0.4);
    } catch (e) {
      console.log("Audio blocked", e);
    }
  }
  
  if (isHapticEnabled && "vibrate" in navigator) {
    navigator.vibrate([200, 100, 200, 100, 400]);
  }
}

function startFullscreenTimer(seconds, exerciseName) {
  clearInterval(timerInterval);
  timeRemaining = seconds;
  initialTime = seconds;

  document.getElementById("timer-exercise-name").innerText = `Resting after: ${exerciseName}`;
  const modal = document.getElementById("fullscreen-timer-modal");
  modal.classList.remove("hidden");

  const orb = document.getElementById("sphere-orb-elem");
  const ring = document.getElementById("sphere-ring-elem");
  orb.className = "sphere-orb";
  ring.className = "sphere-ring";

  updateTimerDisplay();

  timerInterval = setInterval(() => {
    timeRemaining--;
    sessionRestSeconds++;
    updateSessionDisplay();
    updateTimerDisplay();

    if (timeRemaining <= 0) {
      clearInterval(timerInterval);
      const display = document.getElementById("fullscreen-timer-display");
      display.innerText = "GO!";
      display.className = "relative z-10 font-mono text-5xl font-black text-emerald-300 tracking-tight drop-shadow-md";
      
      orb.className = "sphere-orb complete";
      ring.className = "sphere-ring complete";
      
      playCompletionChime();
    }
  }, 1000);
}

function updateTimerDisplay() {
  const display = document.getElementById("fullscreen-timer-display");
  const orb = document.getElementById("sphere-orb-elem");
  const ring = document.getElementById("sphere-ring-elem");
  const core = document.getElementById("sphere-core-elem");

  if (timeRemaining > 0) {
    const mins = String(Math.floor(timeRemaining / 60)).padStart(2, '0');
    const secs = String(timeRemaining % 60).padStart(2, '0');
    display.innerText = `${mins}:${secs}`;

    const ratio = Math.max(0, timeRemaining / (initialTime || 1));
    core.style.transform = `scale(${0.3 + ratio * 0.7})`;
    core.style.opacity = `${0.2 + ratio * 0.8}`;

    if (timeRemaining <= 15) {
      display.className = "relative z-10 font-mono text-5xl font-black text-red-400 tracking-tight drop-shadow-md";
      orb.className = "sphere-orb warning";
      ring.className = "sphere-ring warning";
    } else if (ratio <= 0.5 || timeRemaining <= 30) {
      display.className = "relative z-10 font-mono text-5xl font-black text-amber-300 tracking-tight drop-shadow-md";
      orb.className = "sphere-orb caution";
      ring.className = "sphere-ring caution";
    } else {
      display.className = "relative z-10 font-mono text-5xl font-black text-sky-300 tracking-tight drop-shadow-md";
      orb.className = "sphere-orb";
      ring.className = "sphere-ring";
    }
  }
}

function adjustTimer(amount) {
  timeRemaining += amount;
  if (timeRemaining < 0) timeRemaining = 0;
  if (timeRemaining > initialTime) initialTime = timeRemaining;
  updateTimerDisplay();
}

