      <span class="text-[10px] bg-sky-950 text-sky-300 px-2 py-0.5 rounded font-bold border border-sky-800/50">
        Baseline: 6'1" (185 cm) | 95 kg
      </span>
    </div>
   
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-center mb-4">
