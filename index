let sessionRestSeconds = 0;
let sessionRunning = false;

function toggleSessionTimer() {
  const btn = document.getElementById("session-toggle-btn");
  if (!sessionRunning) {
    sessionRunning = true;
    btn.innerText = "Pause Session";
    btn.className = "bg-amber-600 hover:bg-amber-500 text-white font-bold text-xs px-4 py-2.5 rounded-xl transition shadow-lg shadow-amber-950/25";
    
    // Enable Focus Mode (Hide distracting UI elements smoothly)
    document.body.classList.add("focus-mode-active");

    sessionInterval = setInterval(() => {
      sessionSeconds++;
      updateSessionDisplay();
    }, 1000);
  } else {
    sessionRunning = false;
    clearInterval(sessionInterval);
    btn.innerText = "Resume Session ";
    btn.className = "bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs px-4 py-2.5 rounded-xl transition shadow-lg shadow-emerald-950/25";
    
    // Disable Focus Mode (Bring UI elements back when paused)
    document.body.classList.remove("focus-mode-active");
  }
}

function resetSessionTimer() {
  sessionRunning = false;
  clearInterval(sessionInterval);
  sessionSeconds = 0;
  sessionRestSeconds = 0;
  updateSessionDisplay();
  document.body.classList.remove("focus-mode-active");
  const btn = document.getElementById("session-toggle-btn");
  btn.innerText = "Start Session ";
  btn.className = "bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs px-4 py-2.5 rounded-xl transition shadow-lg shadow-emerald-950/25";
}

function updateSessionDisplay() {
  const hrs = String(Math.floor(sessionSeconds / 3600)).padStart(2, '0');
  const mins = String(Math.floor((sessionSeconds % 3600) / 60)).padStart(2, '0');
  const secs = String(sessionSeconds % 60).padStart(2, '0');
  
  document.getElementById("top-timer-display").innerText = `${hrs}:${mins}:${secs}`;
  
  const netSecs = Math.max(0, sessionSeconds - sessionRestSeconds);
  const netHours = (netSecs / 3600).toFixed(2);
  const restMins = Math.floor(sessionRestSeconds / 60);
  const restSecsRemainder = sessionRestSeconds % 60;
  
  document.getElementById("top-session-metrics").innerText = `Total Rest: ${restMins}m ${restSecsRemainder}s | Net Trained: ${netHours} hrs`;
}

function endAndLogSession() {
  if (sessionSeconds === 0) {
    alert("Please start the session timer before logging.");
    return;
  }
  
  sessionRunning = false;
  clearInterval(sessionInterval);
  document.body.classList.remove("focus-mode-active");
  
  const dateStr = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  const totalHoursStr = (sessionSeconds / 3600).toFixed(2);
  const restHoursStr = (sessionRestSeconds / 3600).toFixed(2);
  const netSecs = Math.max(0, sessionSeconds - sessionRestSeconds);
  const netHoursStr = (netSecs / 3600).toFixed(2);
  
  const logEntry = {
    date: dateStr,
    totalTimeSecs: sessionSeconds,
    restTimeSecs: sessionRestSeconds,
    netTimeSecs: netSecs,
    netHours: netHoursStr
  };
  
  const history = JSON.parse(localStorage.getItem("training_session_logs")) || [];
  history.unshift(logEntry);
  localStorage.setItem("training_session_logs", JSON.stringify(history));
  
  renderSessionLogs();
  resetSessionTimer();
  alert(`Session Logged Successfully!\nDate: ${dateStr}\nNet Trained: ${netHoursStr} Hours (Rest Subtracted)`);
}

