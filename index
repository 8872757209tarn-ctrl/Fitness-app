      </div>
    </details>
  </section>

  <!-- COLLAPSIBLE: Complete Exercise History & Log Book Section (Hides in Focus Mode) -->
  <section class="glass-card p-4 rounded-2xl focus-hidden-element">
    <details open class="group">
      <summary class="flex justify-between items-center cursor-pointer select-none">
        <h2 class="text-sm font-bold flex items-center gap-1.5">
          <span>📊</span> Complete Exercise Performance History
        </h2>
        <div class="flex items-center gap-2">
          <button onclick="event.stopPropagation(); renderExerciseHistory();" class="bg-slate-800 hover:bg-slate-700 text-sky-400 text-xs px-3 py-1.5 rounded-xl font-semibold transition">
