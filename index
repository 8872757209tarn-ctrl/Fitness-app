    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
      <div class="bg-slate-900/90 p-3 rounded-xl border border-slate-800">
        <span class="font-bold text-sky-400 block mb-1">Creatine Monohydrate (5g / Daily)</span>
