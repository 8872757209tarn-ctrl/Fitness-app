<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>Pro Fitness & Elite Nutrition Suite</title>
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<style>
:root {
  --sat: env(safe-area-inset-top);
  --sab: env(safe-area-inset-bottom);
  
  --bg-color: #070a0f;
  --text-primary: #f8fafc;
  --text-muted: #94a3b8;
  --glass-bg: rgba(18, 24, 38, 0.7);
  --glass-border: rgba(255, 255, 255, 0.07);
  --card-inner-bg: rgba(15, 23, 42, 0.9);
  --input-bg: #0f172a;
  --border-subtle: #1e293b;
}

body.theme-light {
  --bg-color: #f1f5f9;
  --text-primary: #0f172a;
  --text-muted: #475569;
  --glass-bg: rgba(255, 255, 255, 0.75);
  --glass-border: rgba(0, 0, 0, 0.08);
  --card-inner-bg: rgba(248, 250, 252, 0.95);
  --input-bg: #ffffff;
  --border-subtle: #e2e8f0;
}

body {
  background-color: var(--bg-color);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  -webkit-tap-highlight-color: transparent;
  -webkit-font-smoothing: antialiased;
  padding-top: max(12px, var(--sat));
  padding-bottom: max(96px, calc(var(--sab) + 64px));
  transition: background-color 0.3s ease, color 0.3s ease;
}

.glass-card {
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--glass-border);
  transition: background 0.3s ease, border-color 0.3s ease;
}

@keyframes glow-border-rotate {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

.btn-glow-animated {
  position: relative;
  background: linear-gradient(90deg, #0284c7, #10b981, #6366f1, #0284c7);
  background-size: 300% 300%;
  animation: glow-border-rotate 4s ease infinite;
  color: #ffffff;
  box-shadow: 0 0 15px rgba(56, 189, 248, 0.4);
  transform: scale(1);
  transition: all 0.2s ease-in-out;
}

.btn-glow-animated:hover {
  transform: translateY(-2px);
  box-shadow: 0 0 25px rgba(56, 189, 248, 0.7);
}

.btn-glow-animated:active {
  transform: translateY(1px) scale(0.98);
}

.tab-active {
  composes: btn-glow-animated;
}
.tab-inactive {
  background-color: var(--card-inner-bg);
  color: var(--text-muted);
}
.overflow-x-auto, .overflow-y-auto {
  -webkit-overflow-scrolling: touch;
}
input, select, textarea {
  font-size: 16px !important;
}

@keyframes pulse-ring {
  0% { transform: scale(0.95); opacity: 0.8; }
  50% { transform: scale(1.05); opacity: 0.3; }
  100% { transform: scale(0.95); opacity: 0.8; }
}
.timer-pulse {
  animation: pulse-ring 2s infinite ease-in-out;
}

@keyframes sphere-spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes sphere-float {
  0% { transform: translateY(0px); filter: drop-shadow(0 15px 25px rgba(0,0,0,0.6)); }
  50% { transform: translateY(-8px); filter: drop-shadow(0 25px 35px rgba(56, 189, 248, 0.25)); }
  100% { transform: translateY(0px); filter: drop-shadow(0 15px 25px rgba(0,0,0,0.6)); }
}

.sphere-wrapper {
  position: relative;
  width: 210px;
  height: 210px;
  margin: 1.5rem auto;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  animation: sphere-float 4s infinite ease-in-out;
}

.sphere-orb {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: radial-gradient(circle at 32% 28%, 
    rgba(255, 255, 255, 0.35) 0%, 
    rgba(255, 255, 255, 0.08) 25%, 
    rgba(56, 189, 248, 0.05) 50%, 
    rgba(15, 23, 42, 0.85) 90%, 
    rgba(2, 6, 23, 0.98) 100%);
  border: 1px solid rgba(255, 255, 255, 0.18);
  box-shadow: 
    inset 0 12px 20px rgba(255, 255, 255, 0.4),
    inset 0 -12px 25px rgba(0, 0, 0, 0.9),
    inset -8px 0 15px rgba(0, 0, 0, 0.6),
    inset 8px 0 15px rgba(255, 255, 255, 0.15),
    0 20px 40px rgba(0, 0, 0, 0.8),
    0 0 25px rgba(56, 189, 248, 0.15);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  transition: all 0.6s ease;
}

.sphere-orb::before {
  content: '';
  position: absolute;
  top: 7%;
  left: 14%;
  width: 50%;
  height: 28%;
  border-radius: 50%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.6) 0%, rgba(255, 255, 255, 0) 100%);
  transform: rotate(-25deg);
  pointer-events: none;
}

.sphere-orb::after {
  content: '';
  position: absolute;
  bottom: 8%;
  right: 18%;
  width: 35%;
  height: 12%;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(56, 189, 248, 0.35) 0%, rgba(0, 0, 0, 0) 80%);
  transform: rotate(-15deg);
  pointer-events: none;
}

.sphere-ring {
  position: absolute;
  inset: -10px;
  border-radius: 50%;
  border: 1.5px solid rgba(56, 189, 248, 0.25);
  border-top-color: rgba(255, 255, 255, 0.6);
  border-bottom-color: rgba(56, 189, 248, 0.1);
  animation: sphere-spin 10s linear infinite;
  transition: all 0.6s ease;
}

.sphere-core {
  position: absolute;
  inset: 22px;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 50%, rgba(56, 189, 248, 0.22) 0%, rgba(14, 165, 233, 0.08) 50%, transparent 80%);
  filter: blur(8px);
  pointer-events: none;
  transition: all 0.6s ease;
}

.sphere-orb.caution {
  background: radial-gradient(circle at 32% 28%, 
    rgba(255, 255, 255, 0.38) 0%, 
    rgba(255, 255, 255, 0.09) 25%, 
    rgba(251, 191, 36, 0.08) 50%, 
    rgba(15, 23, 42, 0.88) 90%, 
    rgba(2, 6, 23, 0.98) 100%);
  border-color: rgba(251, 191, 36, 0.3);
  box-shadow: 
    inset 0 12px 20px rgba(255, 255, 255, 0.4),
    inset 0 -12px 25px rgba(0, 0, 0, 0.9),
    0 0 25px rgba(245, 158, 11, 0.2);
}
.sphere-orb.caution::after {
  background: radial-gradient(ellipse at center, rgba(245, 158, 11, 0.35) 0%, rgba(0, 0, 0, 0) 80%);
}
.sphere-ring.caution {
  border-color: rgba(245, 158, 11, 0.3);
  border-top-color: rgba(255, 255, 255, 0.7);
}

.sphere-orb.warning {
  background: radial-gradient(circle at 32% 28%, 
    rgba(255, 255, 255, 0.4) 0%, 
    rgba(255, 255, 255, 0.1) 25%, 
    rgba(248, 113, 113, 0.08) 50%, 
    rgba(15, 23, 42, 0.88) 90%, 
    rgba(2, 6, 23, 0.98) 100%);
  border-color: rgba(248, 113, 113, 0.3);
  box-shadow: 
    inset 0 12px 20px rgba(255, 255, 255, 0.4),
    inset 0 -12px 25px rgba(0, 0, 0, 0.9),
    0 0 30px rgba(239, 68, 68, 0.25);
}
.sphere-orb.warning::after {
  background: radial-gradient(ellipse at center, rgba(239, 68, 68, 0.4) 0%, rgba(0, 0, 0, 0) 80%);
}
.sphere-ring.warning {
  border-color: rgba(239, 68, 68, 0.3);
  border-top-color: rgba(255, 255, 255, 0.8);
  animation-duration: 3s;
}

.sphere-orb.complete {
  background: radial-gradient(circle at 32% 28%, 
    rgba(255, 255, 255, 0.45) 0%, 
    rgba(255, 255, 255, 0.12) 25%, 
    rgba(52, 211, 153, 0.1) 50%, 
    rgba(15, 23, 42, 0.88) 90%, 
    rgba(2, 6, 23, 0.98) 100%);
  border-color: rgba(52, 211, 153, 0.4);
  box-shadow: 
    inset 0 12px 22px rgba(255, 255, 255, 0.5),
    inset 0 -12px 25px rgba(0, 0, 0, 0.9),
    0 0 35px rgba(16, 185, 129, 0.3);
}
.sphere-orb.complete::after {
  background: radial-gradient(ellipse at center, rgba(16, 185, 129, 0.45) 0%, rgba(0, 0, 0, 0) 80%);
}
.sphere-ring.complete {
  border-color: rgba(16, 185, 129, 0.4);
  border-top-color: rgba(255, 255, 255, 0.85);
}

/* Smooth Focus Mode Transitions */
.focus-hidden-element {
  transition: all 0.7s cubic-bezier(0.4, 0, 0.2, 1);
  max-height: 2000px;
  opacity: 1;
  overflow: hidden;
}
.focus-mode-active .focus-hidden-element {
  max-height: 0;
  opacity: 0;
  margin-top: 0 !important;
  margin-bottom: 0 !important;
  padding-top: 0 !important;
  padding-bottom: 0 !important;
  border-width: 0 !important;
  pointer-events: none;
}
</style>
</head>
<body class="p-4 sm:p-5 max-w-5xl mx-auto">

<!-- TOP PRIORITY FOCUS: ACTIVE WORKOUT TRACKER BLOCK -->
<section class="glass-card p-4 rounded-2xl border-2 border-sky-500/50 mb-6 shadow-xl bg-slate-900/90 relative z-20">
  <div class="flex items-center justify-between flex-wrap gap-3">
    <div>
      <span class="text-[10px] font-bold text-sky-400 uppercase tracking-widest bg-sky-950 px-2.5 py-0.5 rounded-full border border-sky-800/50">⚡ Active Live Tracker</span>
      <h2 class="text-xl font-black text-white mt-1 flex items-center gap-2">
        <span>⏱️</span> <span id="top-timer-display">00:00:00</span>
      </h2>
      <p id="top-session-metrics" class="text-xs text-slate-400 mt-1 font-mono">
        Total Rest: 0m 0s | Net Trained: 0.00 hrs
      </p>
    </div>
    <div class="flex gap-2 flex-wrap">
      <button onclick="toggleSessionTimer()" id="session-toggle-btn" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs px-4 py-2.5 rounded-xl transition shadow-lg shadow-emerald-950/25">
        Start Session 
      </button>
      <button onclick="endAndLogSession()" class="bg-red-600 hover:bg-red-500 text-white font-bold text-xs px-4 py-2.5 rounded-xl transition shadow-lg shadow-red-950/25">
        End & Log 
      </button>
      <button onclick="resetSessionTimer()" class="bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold text-xs px-3 py-2.5 rounded-xl transition">
        Reset
      </button>
    </div>
  </div>
</section>

<!-- Header & Nav Tabs (Hides in Focus Mode) -->
<header class="border-b border-slate-800 pb-4 mb-6 focus-hidden-element">
  <div class="flex justify-between items-center mb-4">
    <div>
      <h1 class="text-2xl font-black bg-gradient-to-r from-sky-400 via-emerald-400 to-indigo-400 bg-clip-text text-transparent">
        Performance Engine
      </h1>
      <p id="current-date" class="text-xs text-slate-400 font-medium"></p>
    </div>
    <div class="flex items-center gap-2">
      <span id="whoop-status-badge" class="text-[10px] font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20 px-2.5 py-1 rounded-full">
        WHOOP: Off
      </span>
    </div>
  </div>

  <div class="flex gap-2 overflow-x-auto pb-1 no-scrollbar">
    <button id="btn-tab-workout" onclick="switchTab('workout')" class="flex-1 min-w-[110px] py-3 rounded-xl font-bold text-xs transition btn-glow-animated whitespace-nowrap">
      🏋️ Training
    </button>
    <button id="btn-tab-nutrition" onclick="switchTab('nutrition')" class="flex-1 min-w-[110px] py-3 rounded-xl font-bold text-xs transition tab-inactive whitespace-nowrap">
      🥗 Nutrition
    </button>
    <button id="btn-tab-body" onclick="switchTab('body')" class="flex-1 min-w-[110px] py-3 rounded-xl font-bold text-xs transition tab-inactive whitespace-nowrap">
      📏 Body & Fat AI
    </button>
  </div>
</header>

<!-- WORKOUT SECTION -->
<main id="section-workout" class="space-y-6">

  <!-- Workout Routine Selector & Cards -->
  <section class="glass-card p-4 rounded-2xl">
    <div class="mb-4">
      <label class="block text-[10px] font-bold text-sky-400 uppercase tracking-wider mb-1">Training Block Phase</label>
